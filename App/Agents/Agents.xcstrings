    "connect.server_address_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your Paperclip server address (default port: 3100). Use http://127.0.0.1:3100 in the simulator, or your computer’s local network or Tailscale address on your phone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写 Paperclip 服务器地址（默认端口 3100）。在模拟器里可以用 http://127.0.0.1:3100；在手机上请用电脑的局域网或 Tailscale 地址。"
          }
        }
      }
    },
