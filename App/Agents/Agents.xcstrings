    "connect.approval.cancelled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The approval request was cancelled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准请求已取消。"
          }
        }
      }
    },
    "connect.approval.expired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The approval request expired. Please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准请求已过期，请重试。"
          }
        }
      }
    },
    "connect.approval.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to confirm approval: %@. Check your connection and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认批准状态：%@。请检查网络后重试。"
          }
        }
      }
    },
    "connect.approval.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As with paperclipai CLI sign-in, the app requests a Board API Key that becomes active after you approve it on the web. The key is stored only in this device’s Keychain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "和 paperclipai CLI 登录相同：App 申请一个 Board API Key，你在网页上批准后它才生效。Key 只保存在本机钥匙串。"
          }
        }
      }
    },
    "connect.approval.instructions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to Paperclip on the page that opens and approve the request. The app will connect automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在打开的页面登录 Paperclip 并点击批准。批准后会自动连接。"
          }
        }
      }
    },
    "connect.approval.invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The approval request is no longer valid. Please sign in again."
