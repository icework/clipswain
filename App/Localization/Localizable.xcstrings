    "assistant.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To draft a task, your text, company name, and agent list (names, roles, and responsibilities) are sent to this provider. Your API key is stored only in this device’s Keychain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成任务时，你输入的文字、公司名和 Agent 列表（名字、角色、职责）会发送给这个服务商。API Key 只保存在这台设备的钥匙串里。"
          }
        }
      }
    },
