            "state": "translated",
            "value": "Please describe the task."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请描述任务内容。"
          }
        }
      }
    },
    "shortcut.invalid_draft": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task draft is invalid. No task was published."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务草稿无效，未发布任务。"
          }
        }
      }
    },
    "shortcut.session_changed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Clipswain connection or company changed. No task was published. Please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipswain 的连接或公司已更改，未发布任务，请重试。"
          }
        }
      }
    },
    "shortcut.submission_uncertain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipswain could not confirm publication. Check your task list before retrying to avoid creating a duplicate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认任务是否发布成功。请先查看任务列表，再决定是否重试，以免重复创建。"
          }
        }
      }
    },
    "shortcut.original_request": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original request"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始口述内容"
          }
        }
      }
    },
    "shortcut.created": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Published %@: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已发布 %@：%@。"
          }
        }
      }
    },
    "shortcut.created_unassigned": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Published %@: %@. Unassigned."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已发布 %@：%@。尚未分配负责人。"
          }
        }
      }
    },
    "markdown.view_column": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View column"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看列"
          }
        }
      }
    },
    "assistant.allow_http": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow HTTP for this AI service"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许此 AI 服务使用 HTTP"
          }
        }
      }
    },
    "assistant.http_warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP sends your API key, task text, and agent information without HTTPS protection. Enable only when you trust the network protecting this connection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP 不提供 HTTPS 保护，会传输 API Key、任务正文和 Agent 信息。仅在确认网络能保护此连接时开启。"
          }
        }
      }
    },
    "connection.address_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your Paperclip HTTPS address. Local HTTP servers (usually port 3100) require enabling HTTP for that address. The simulator can reach your Mac at 127.0.0.1; a phone needs a reachable LAN or Tailscale address."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入 Paperclip 的 HTTPS 地址。局域网 HTTP 服务器（通常使用 3100 端口）需单独开启 HTTP。模拟器可用 127.0.0.1 访问 Mac，手机需使用可达的局域网或 Tailscale 地址。"
          }
        }
      }
    },
    "connection.allow_http": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow HTTP for this server"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许此服务器使用 HTTP"
          }
        }
      }
    },
    "connection.http_warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP sends your key and task data without HTTPS protection. Enable only on a network you trust, such as your own protected LAN or Tailscale connection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP 不提供 HTTPS 保护，会传输密钥和任务数据。仅在可信网络（例如受保护的局域网或 Tailscale 连接）中开启。"
          }
        }
      }
    },
    "connection.key_removal_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved key could not be removed. Connection settings were kept. Unlock your device and try disconnecting again; server revocation may already have completed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法移除已保存的密钥，连接设置已保留。请解锁设备后再次断开；服务器端撤销可能已经完成。"
          }
        }
      }
    },
    "connection.revoke_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnected on this device, but server key revocation could not be confirmed. The key may still be active. Open the server in your browser and revoke this device’s Board API key."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机已断开，但无法确认服务器端密钥是否撤销，密钥可能仍有效。请在浏览器打开服务器，撤销此设备的 Board API Key。"
          }
        }
      }
    },
    "settings.revoke_attempt_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnecting removes the saved key from this device and attempts to revoke it on the server. If revocation cannot be confirmed, you will be told to revoke it in the browser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开时会移除本机保存的密钥并尝试在服务器撤销；若无法确认撤销结果，会提示你到浏览器中撤销。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
