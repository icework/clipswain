    "settings.notifications_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS periodically checks for selected task events and items needing attention, including questions, approvals and failures. Configure types in Inbox filters. iOS controls the frequency, typically every few dozen minutes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 会不定期检查选中的任务事件，以及提问、审批和失败等待处理事项。可在收件箱筛选中配置提醒类型；频率由 iOS 决定，通常间隔几十分钟。"
          }
        }
      }
    },
