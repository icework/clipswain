      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time measurements"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "耗时口径"
          }
        }
      }
