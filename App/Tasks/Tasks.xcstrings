    "inbox.filter_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off a type to hide its events and stop its background notifications. History is kept and returns when you turn it back on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭某类事件后，将隐藏这些记录并停止该类后台提醒。历史仍会保留，重新开启即可查看。"
          }
        }
      }
