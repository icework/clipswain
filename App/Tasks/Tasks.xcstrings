    "composer.example_assigned": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example: Ask %@ to fix the login screen crash by Friday. It is urgent; add unit tests afterward."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：让 %@ 周五前把登录页的崩溃修掉，挺急的，修完补上单测。"
          }
        }
      }
    },
    "composer.example_logs": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, organize the iOS crash logs by tomorrow. This is urgent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 明天之前把 iOS 版本的崩溃日志整理一下，紧急"
          }
        }
      }
    },
    "composer.example_research": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask %@ to compare pricing plans for three competitors by next Monday. No rush."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请 %@ 调研三个竞品的定价方案，写一份对比，下周一给我，不急"
          }
        }
      }
    },
    "composer.example_unassigned": {
      "extractionState": "manual",
