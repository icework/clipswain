    "task.timing_explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Elapsed time runs from creation to completion or now, including waiting and blocked periods. Linked run time adds up each run from start to finish, including tool and model waits. A run may involve multiple tasks, and concurrent runs may add up to more than elapsed time; this is not time spent exclusively on this task. Waiting time is not estimated when status records are incomplete."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总历时从创建算到完成或现在，包含等待和阻塞。关联运行累计是各次运行从启动到结束的时间，包含工具和模型等待；同一次运行可能涉及多个任务，并行时累计可超过总历时，不代表任务独占工时。状态记录不完整时，不推算等待时长。"
          }
        }
      }
    },
